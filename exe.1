# Atividade 1 - Variáveis, operações e expressões em Python

# Armazena um nome em uma variável e exibe na tela
linguagem = "Java"
print(linguagem)
# Java

# Realiza uma operação matemática simples 
print(5 + 2 * 3)
# 11

# Armazena uma mensagem de texto em uma variável e exibe na tela
mensagem = "Olá, Java!"
print(mensagem)
# Olá, Java!

# Armazena o resultado de uma operação matemática em uma variável
resultado = 5 + 2 * 3
# 11
print(resultado)

# Armazena a expressão matemática (em formato de texto) em uma variável
expressao_texto = "5 + 2 * 3"
print(expressao_texto)

# Concatena o texto da expressão com o resultado, convertendo o número em texto
expressao_completa = expressao_texto + " = " + str(resultado)
print(expressao_completa)

# Faz a mesma concatenação acima, porém usando f-string
expressao_completa_fstring = f"{expressao_texto} = {resultado}"
print(expressao_completa_fstring)




